{
  "name": "acme-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Acme work items and wiki for agents, as an MCP server (stdio) and a CLI.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "acme-mcp": "dist/cli.js"
