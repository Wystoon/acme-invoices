{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "acme-dev",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "enabledMcpjsonServers": [
    "acme"
  ],
  "permissions": {
    "allow": [
      "mcp__acme__get_work_item_context",
      "mcp__acme__search_wiki",
      "mcp__acme__get_wiki_section",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet csharpier *)",
      "Bash(dotnet ef *)",
      "Bash(dotnet tool restore)",
      "Bash(npm --prefix src/frontend run *)",
      "Bash(npm --prefix src/frontend test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git -C {{REPO_ROOT}} status *)",
      "Bash(git -C {{REPO_ROOT}} log *)",
      "Bash(git -C {{REPO_ROOT}} diff *)",
      "Bash(git -C {{REPO_ROOT}} branch)",
      "Bash(git -C {{REPO_ROOT}} branch --show-current)",
      "Bash(git -C {{REPO_ROOT}} branch -a)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)"
    ],
    "ask": [
      "mcp__acme__create_pr",
      "mcp__acme__post_pr_comment"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.claude/**)",
      "Edit(./tools/hooks/**)",
      "Edit(./.mcp.json)",
      "Edit(./CLAUDE.md)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "WebFetch",
      "WebSearch",
      "Agent(general-purpose)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(claude)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Agent(fork)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/session-start.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-bash.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/audit.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/audit.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
